### prefix:-1:Languagesystems ###
### open prefix 'Languagesystems' ###
languagesystem DFLT dflt;

languagesystem latn dflt;
languagesystem latn ROM;
languagesystem latn MOL;
languagesystem latn CAT;
languagesystem latn NLD;
### close prefix 'Languagesystems' ###

### feature:0:aalt ###
feature aalt {
### open feature 'aalt' ###
feature locl;
feature isol;
feature init;
feature medi;
feature fina;
feature ss01;
feature ss02;
feature ss03;
feature calt;
feature ss04;
feature ss05;
feature ss06;
### close feature 'aalt' ###
} aalt;

### feature:1:locl ###
feature locl {
### open feature 'locl' ###
script latn;
language ROM;
lookup locl_latn_0 {
	sub Scedilla by uni0218;
	sub uni0162 by uni021A;
} locl_latn_0;
language MOL;
lookup locl_latn_0;

script latn;
language CAT;
lookup locl_latn_1 {
	sub  L' periodcentered' L by Ldot;
} locl_latn_1;

script latn;
language NLD;
lookup locl_latn_2 {
	sub Iacute J' by uni004A0301;
} locl_latn_2;
### close feature 'locl' ###
} locl;

### feature:2:isol ###
feature isol {
### open feature 'isol' ###
sub K by K.isol;
sub R by R.isol;
### close feature 'isol' ###
} isol;

### feature:3:init ###
feature init {
### open feature 'init' ###
sub K by K.init;
sub R by R.init;
sub Racute by Racute.init;
sub Rcaron by Rcaron.init;
sub uni0156 by uni0156.init;
### close feature 'init' ###
} init;

### feature:4:medi ###
feature medi {
### open feature 'medi' ###
sub K by K.medi;
sub R by R.medi;
sub Racute by Racute.medi;
sub Rcaron by Rcaron.medi;
sub uni0156 by uni0156.medi;
### close feature 'medi' ###
} medi;

### feature:5:fina ###
feature fina {
### open feature 'fina' ###
sub K by K.fina;
sub R by R.fina;
sub Racute by Racute.fina;
sub Rcaron by Rcaron.fina;
sub uni0156 by uni0156.fina;
### close feature 'fina' ###
} fina;

### feature:6:dlig ###
feature dlig {
