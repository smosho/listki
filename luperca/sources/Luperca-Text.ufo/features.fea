### feature:7:ss01 ###
feature ss01 {
featureNames {
	name 3 1 0x409 "Tall letters";
	name 3 1 0x409 "Alternate A";
};
### open feature 'ss01' ###
sub A by A.ss01;
sub Aacute by Aacute.ss01;
sub Abreve by Abreve.ss01;
sub Acircumflex by Acircumflex.ss01;
sub Adieresis by Adieresis.ss01;
sub Agrave by Agrave.ss01;
sub Amacron by Amacron.ss01;
sub Aogonek by Aogonek.ss01;
sub Aring by Aring.ss01;
sub Atilde by Atilde.ss01;
### close feature 'ss01' ###
} ss01;

### feature:8:ss02 ###
feature ss02 {
featureNames {
	name 3 1 0x409 "Swash letters";
};
### open feature 'ss02' ###
sub A by A.ss02;
sub Aacute by Aacute.ss02;
sub Abreve by Abreve.ss02;
sub Acircumflex by Acircumflex.ss02;
sub Adieresis by Adieresis.ss02;
sub Agrave by Agrave.ss02;
sub Amacron by Amacron.ss02;
sub Aogonek by Aogonek.ss02;
sub Aring by Aring.ss02;
sub Atilde by Atilde.ss02;
sub J by J.ss02;
sub N by N.ss02;
sub Y by Y.ss02;
sub Yacute by Yacute.ss02;
sub Ycircumflex by Ycircumflex.ss02;
sub Ydieresis by Ydieresis.ss02;
sub Ygrave by Ygrave.ss02;
### close feature 'ss02' ###
} ss02;

### feature:9:ss03 ###
feature ss03 {
featureNames {
	name 3 1 0x409 "Tall letters";
};
### open feature 'ss03' ###
sub F by F.ss03;
sub L by L.ss03;
sub T by T.ss03;
### close feature 'ss03' ###
} ss03;

### feature:10:calt ###
feature calt {
### open feature 'calt' ###
# BEGIN POSITIONAL ALTERNATES

lookup InitForms {
	ignore sub @AllLetters @initDef';
	sub @initDef' by @initSub;
} InitForms;

lookup MediForms {
	sub @AllLetters @mediDef' @AllLetters by @mediSub;
} MediForms;

lookup FinaForms {
	ignore sub @finaDef' @AllLetters;
	sub @finaDef' by @finaSub;
} FinaForms;

lookup IsolForms {
	ignore sub @isolDef' @AllLetters, @AllLetters @isolDef';
	sub @isolDef' by @isolSub;
} IsolForms;

# END POSITIONAL ALTERNATES
### close feature 'calt' ###
} calt;

### feature:11:ss04 ###
feature ss04 {
featureNames {
	name 3 1 0x409 "Short Q";
};
### open feature 'ss04' ###
sub Q by Q.ss04;
### close feature 'ss04' ###
} ss04;

### feature:12:ss05 ###
feature ss05 {
featureNames {
	name 3 1 0x409 "Sunken L";
};
### open feature 'ss05' ###
sub L by L.ss05;
sub Lacute by Lacute.ss05;
sub Lcaron by Lcaron.ss05;
sub uni013B by uni013B.ss05;
sub Lslash by Lslash.ss05;
### close feature 'ss05' ###
} ss05;

### feature:13:ss06 ###
feature ss06 {
featureNames {
	name 3 1 0x409 "Angular punctuation";
};
### open feature 'ss06' ###
sub Y by Y.ss06;
sub Yacute by Yacute.ss06;
sub Ycircumflex by Ycircumflex.ss06;
sub Ydieresis by Ydieresis.ss06;
sub Ygrave by Ygrave.ss06;
sub period by period.ss06;
sub comma by comma.ss06;
sub colon by colon.ss06;
sub semicolon by semicolon.ss06;
sub ellipsis by ellipsis.ss06;
sub periodcentered by periodcentered.ss06;
### close feature 'ss06' ###
} ss06;

### feature:-1:kern ###
feature kern {
### open feature 'kern' ###
	lookup kern_DFLT {
		lookupflag IgnoreMarks;
		pos four B -16;
		pos four D -16;
		pos four Dcaron -16;
		pos four Dcroat -16;
		pos four Eth -16;
		pos four E -16;
		pos four Eacute -16;
		pos four Ecaron -16;
		pos four Ecircumflex -16;
		pos four Edieresis -16;
		pos four Edotaccent -16;
		pos four Egrave -16;
		pos four Emacron -16;
		pos four Eogonek -16;
		pos four F -16;
		pos four H -16;
		pos four Hbar -16;
		pos four K -16;
		pos four uni0136 -16;
		pos four L -16;
		pos four Lacute -16;
		pos four Lcaron -16;
		pos four uni013B -16;
		pos four Ldot -16;
		pos four Lslash -16;
		pos four N -16;
		pos four Nacute -16;
		pos four Ncaron -16;
		pos four uni0145 -16;
		pos four Ntilde -16;
		pos four P -16;
		pos four Thorn -16;
		pos four R -16;
